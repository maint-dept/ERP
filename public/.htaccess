# =========================================================================
# Al-Muslim Group Garments Factory Maintenance Machine ERP
# LiteSpeed & Apache Enterprise SPA Route Fallback Configuration
# =========================================================================

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS for secure data transmission
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 1.1 Block direct HTTP access to database backups and SQL dumps
  RewriteRule ^backups/ - [F,L]
  RewriteRule ^data/.*\.sql$ - [F,L]

  # 2. Allow direct access to real existing files and directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. LiteSpeed & Apache: Rewrite all SPA module routes to /index.html
  RewriteRule ^(.*)$ /index.html [L,QSA]
</IfModule>

# 3. LiteSpeed & Apache Native Fallback:
# If mod_rewrite is disabled or bypassed by LiteSpeed, ErrorDocument 404 serves /index.html
ErrorDocument 404 /index.html

# 4. Prevent browser caching of HTML entrypoints, JS modules & CSS assets
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  <FilesMatch "\.(js|mjs|css|json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Block Search Engine indexers on administrative and sensitive endpoints
  <IfModule mod_setenvif.c>
    SetEnvIfNoCase Request_URI "(admin|gateway|api|backups)" IS_PRIVATE_ENDPOINT
  </IfModule>
  Header set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet" env=IS_PRIVATE_ENDPOINT
</IfModule>
